{
  "manifest_version": 3,
  "name": "Noted",
  "version": "1.0.0",
  "description": "Adds a Record button inside Google Meet that opens Noted's recorder for the call you're in.",
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "action": {
    "default_title": "Noted",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
