# Sign-in. Auth.js signs the session cookie with AUTH_SECRET (any 32+ random
# bytes, base64). The Google OAuth client needs
#   https://<host>/api/auth/callback/google
# as an authorised redirect URI. Sign-in asks for identity only; the calendar
# is a second consent from inside the app.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Analysis, grounded Ask, and the workspace-wide Ask. Without this the import
# and record routes return 503 and say so; everything else still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Transcription. Deepgram rather than Whisper because Whisper has no
# diarization, and speaker attribution is the whole thesis of this build.
# Without it, a recorded call is transcribed from your microphone only
# (Web Speech API) and the page says the far side went unheard.
DEEPGRAM_API_KEY=

# Postgres. Required: users, meetings, transcripts, speakers, summaries,
# actions, highlights, settings and the audio itself when there is no object
# store. Nothing past the landing page works without it.
# Any variable whose VALUE is a postgres:// URL is found automatically, whatever
# it is called, because attaching a store on Vercel can prefix the name.
DATABASE_URL=

# Optional. When a Vercel Blob store is attached, audio goes there instead of
# into Postgres. Either the classic token, or the store id that newer stores
# issue (authenticated by the deployment's own VERCEL_OIDC_TOKEN).
BLOB_READ_WRITE_TOKEN=
